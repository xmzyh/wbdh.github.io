    <style>
       * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Microsoft YaHei", "PingFang SC", sans-serif; }
        body { 
            min-height: 100vh;
            max-width: 800px; 
            margin: 0 auto; 
            padding: 20px; 
            background: #050b18;
            background-image: url('https://ghfast.top/raw.githubusercontent.com/xmzyh/wbdh.github.io/main/bj.jpg'); /* 永久可用的科技风背景图 */
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            /* 移除 background-blend-mode: overlay; 解决蒙版混合问题 */
            color: #ccd6f6;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            z-index: -4;
        }
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 200%;
            height: 200%;
            background: 
                linear-gradient(rgba(18, 100, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(18, 100, 255, 0.1) 1px, transparent 1px);
            background-size: 30px 30px;
            z-index: -3;
            animation: gridRotate 20s linear infinite;
            transform-origin: center center;
        }
        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            /* 移除径向渐变遮罩，或保留低透明度（按需调整） */
            background: radial-gradient(circle at 50% 50%, rgba(12, 34, 78, 0.2), #050b18 70%);
            z-index: -2;
        }
        @keyframes gridRotate {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(1deg) scale(1.05); }
            100% { transform: rotate(0deg) scale(1); }
        }
        .container { 
            width: 100%;
            background: rgba(12, 34, 78, 0.5); /* 适度透明：0.5 不影响背景显示，又保证内容清晰 */
            backdrop-filter: blur(15px);
            border: 1px solid rgba(38, 139, 255, 0.3);
            border-radius: 20px;
            padding: 40px 30px;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
            /* 新增：确保内容框不遮挡背景，且自身半透明 */
            opacity: 1;
        }
        .container .neon-border {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border: 2px solid transparent;
            border-radius: 20px;
            background: linear-gradient(
                45deg, 
                transparent 50%, 
                rgba(38, 139, 255, 0.4), 
                rgba(100, 216, 247, 0.4)
            ) border-box;
            -webkit-mask: 
                linear-gradient(#fff 0 0) padding-box, 
                linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: neonBreathe 4s ease-in-out infinite;
            z-index: -1;
        }
        @keyframes neonBreathe {
            0%,100% { opacity: 0.6; }
            50% { opacity: 1; }
        }
        .container .light-sweep {
            position: absolute;
            top: 0;
            left: -150%;
            width: 50%;
            height: 100%;
            background: linear-gradient(
                45deg, 
                transparent, 
                rgba(100, 216, 247, 0.08), 
                transparent
            );
            animation: lightSweep 6s linear infinite;
            z-index: 0;
        }
        @keyframes lightSweep {
            0% { left: -150%; transform: skewX(-20deg); }
            100% { left: 150%; transform: skewX(-20deg); }
        }
        h1 { 
            font-size: 30px; 
            color: #268bff;
            text-align: center; 
            margin-bottom: 8px;
            text-shadow: 0 0 20px rgba(38, 139, 255, 0.4);
            position: relative;
            z-index: 1;
        }
        h2 { 
            font-size: 16px; 
            color: #8892b0;
            text-align: center; 
            margin-bottom: 25px;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }
        .countdown-panel {
            padding: 20px 20px;
            background: rgba(5, 15, 35, 0.5);
            border: 1px solid rgba(38, 139, 255, 0.2);
            border-radius: 12px;
            margin-bottom: 25px;
            position: relative;
            z-index: 1;
            text-align: center;
        }
        .countdown-label {
            font-size: 14px;
            color: #8892b0;
            margin-bottom: 10px;
            display: block;
        }
        .countdown-value {
            font-size: 28px;
            color: #64d8f7;
            font-weight: 600;
            text-shadow: 0 0 15px rgba(100, 216, 247, 0.4);
            letter-spacing: 4px;
        }
        #generateBtn { 
            width: 100%; 
            height: 58px; 
            background: linear-gradient(135deg, #1677ff, #268bff);
            color: #fff; 
            border: none; 
            border-radius: 12px; 
            font-size: 18px; 
            cursor: pointer; 
            transition: all 0.3s ease;
            font-weight: 500;
            position: relative;
            overflow: hidden;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
            box-shadow: 0 0 20px rgba(22, 119, 255, 0.3);
        }
        #generateBtn::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            transform: translate(-50%, -50%);
            animation: btnPulse 3s ease-in-out infinite;
            z-index: -1;
        }
        @keyframes btnPulse {
            0%,100% { width: 0; height: 0; opacity: 0.8; }
            50% { width: 200px; height: 200px; opacity: 0; }
        }
        #generateBtn:hover { 
            background: linear-gradient(135deg, #0d66e6, #1677ff);
            box-shadow: 0 0 30px rgba(22, 119, 255, 0.5);
            transform: translateY(-2px);
        }
        #generateBtn:active {
            transform: translateY(0);
            box-shadow: 0 0 20px rgba(22, 119, 255, 0.3);
        }
        #generateBtn.loading {
            background: #445069;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
            animation: none;
        }
        #generateBtn.loading::before {
            animation: none;
        }
        .btn-loading-icon {
            width: 24px;
            height: 24px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s linear infinite;
            margin-right: 10px;
            display: none;
        }
        #generateBtn.loading .btn-loading-icon {
            display: inline-block;
        }

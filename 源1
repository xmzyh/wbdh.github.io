                }}
            };
            /************************** 【数据替换标记End】**************************/

            console.log('内置商品数据：', innerGoodsData);
            console.log('商品列表：', innerGoodsData?.data?.floorData?.items?.[0]?.productList);

            function parseGoods() {
                const goodsList = [];
                const productList = innerGoodsData?.data?.floorData?.items?.[0]?.productList || [];
                if (productList.length === 0) {
                    console.error('未获取到商品列表，检查数据层级！');
                    return goodsList;
                }
                
                productList.forEach(item => {
                    // 核心修改：缺失businessType时自动填充为119501
                    let businessType = '';
                    if (item.jumpUrl) {
                        const reg = /businessType=([^&]+)/;
                        const match = item.jumpUrl.match(reg);
                        businessType = match ? match[1] : '119501';
                    } else {
                        businessType = '119501';
                    }

                    const params = { 
                        businessType: businessType,  // 赋值处理后的businessType
                        activityId: item.activityId || '', 
                        skuId: item.skuId || '' 
                    };

                    const baseUrl = 'https://m-sep.jd.com/Settlement?showhead=no';
                    const query = Object.entries(params).filter(([k, v]) => v).map(([k, v]) => `${k}=${v}`).join('&');
                    const targetUrl = query ? `${baseUrl}&${query}` : baseUrl;

                    goodsList.push({
                        name: item.rewardName || '未知商品',
                        params: params,
                        targetUrl: targetUrl
                    });
                });
                return goodsList;
            }

            function copyLink(url) {
                navigator.clipboard.writeText(url).then(() => showCopyTip())
                .catch(() => {
                    const input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    document.body.removeChild(input);
                    showCopyTip();
                });
            }

            function showCopyTip() {
                copySuccess.style.display = 'block';
                setTimeout(() => copySuccess.style.display = 'none', 1500);
            }

            function renderQrcode(goodsList) {
                resultArea.innerHTML = '';
                if (goodsList.length === 0) {
                    resultArea.innerHTML = '<div class="empty-tip">未提取到有效商品信息，请检查内置数据！</div>';
                    return;
                }

                goodsList.forEach((goods, index) => {
                    const goodsItem = document.createElement('div');
                    goodsItem.className = 'goods-item';

                    const nameDiv = document.createElement('div');
                    nameDiv.className = 'goods-name';
                    nameDiv.innerText = `${index + 1}、${goods.name}`;
                    goodsItem.appendChild(nameDiv);

                    // 仅提示activityId/skuId缺失，businessType已自动填充，不再提示
                    const lackParams = [];
                    if (!goods.params.activityId) lackParams.push('activityId');
                    if (!goods.params.skuId) lackParams.push('skuId');
                    if (lackParams.length > 0) {
                        const tipDiv = document.createElement('div');
                        tipDiv.className = 'param-tip';
                        tipDiv.innerText = `缺失参数：${lackParams.join('、')}（二维码可能无效）`;
                        goodsItem.appendChild(tipDiv);
                    }

                    const qrBox = document.createElement('div');
                    qrBox.className = 'qrcode-box';
                    qrBox.id = `qrcode_${index}`;
                    qrBox.onclick = () => copyLink(goods.targetUrl);
                    goodsItem.appendChild(qrBox);

                    resultArea.appendChild(goodsItem);

                    new QRCode(document.getElementById(`qrcode_${index}`), {
                        text: goods.targetUrl,
                        width: 160,
                        height: 160,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });
                });
            }

            let isGenerating = false;
            generateBtn.addEventListener('click', function() {
                if (isGenerating) return;
                isGenerating = true;
                try {
                    const goodsList = parseGoods();
                    renderQrcode(goodsList);
                } catch (e) {
                    console.error('生成失败：', e);
                    alert(`解析失败：${e.message}`);
                } finally {
                    isGenerating = false;
                }
            });
        });
